{
  "name": "json2model",
  "version": "0.1.0",
  "private": true,
  "description": "A local browser tool that converts JSON into Dart, TypeScript, and Pydantic models.",
  "author": "JSON2Model contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:e2e": "playwright test",
    "test:e2e:production": "cross-env PLAYWRIGHT_PRODUCTION=1 playwright test",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "validate:typescript": "npm run fixtures:generate && tsc --project tests/generated/typescript/tsconfig.json",
    "validate:python": "npm run fixtures:generate && python -m ruff check tests/generated/python && python tests/generated/python/validate.py",
    "validate:dart": "npm run fixtures:generate && dart analyze tests/generated/dart && dart run tests/generated/dart/round_trip.dart",
    "desktop:build": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --dir",
    "desktop:smoke": "node scripts/smoke-desktop.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.0",
    "globals": "16.5.0",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0",
    "vite": "8.2.0",
    "vitest": "3.2.7"
  },
  "comments": {
    "overrides": [
      "Pulls a patched build dependency without waiting for the package that",
      "depends on it. @babel/core covers GHSA-4x5r-pxfx-6jf8 and reaches the",
      "project through @vitejs/plugin-react. It is a build tool and does not",
      "appear in the browser bundle.",
      "brace-expansion is deliberately not overridden: its 5.x release changes",
      "the module export shape, and forcing it breaks minimatch consumers with",
      "'expand is not a function'."
    ]
  },
  "overrides": {
    "@babel/core": "^7.29.7"
  },
  "build": {
    "appId": "com.json2model.desktop",
    "productName": "JSON2Model",
    "copyright": "Copyright © 2026 JSON2Model contributors",
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/*.map"
    ],
    "extraFiles": [
      {
        "from": "electron/README.txt",
        "to": "README.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "win": {
      "icon": "build-resources/icon.ico"
    }
  }
}
