{
  "name": "json2model",
  "version": "0.1.0",
  "private": true,
  "description": "A local browser tool that converts JSON into Dart, TypeScript, and Pydantic models.",
  "author": "JSON2Model contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:static": "vite build --config vite.static.config.ts",
    "preview": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "preview:static": "vite preview --config vite.static.config.ts",
    "desktop:build": "npm run build:static && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --dir",
    "desktop:smoke": "node scripts/smoke-desktop.mjs",
    "start": "npm run preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-static --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern docs/screenshots",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:e2e": "playwright test",
    "test:e2e:production": "cross-env PLAYWRIGHT_PRODUCTION=1 playwright test tests/browser/smoke.spec.ts",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "validate:typescript": "npm run fixtures:generate && tsc --strict --noEmit --skipLibCheck tests/generated/models.ts",
    "validate:python": "npm run fixtures:generate && python -m ruff check tests/generated/models.py tests/generated/validate_python.py && python tests/generated/validate_python.py",
    "validate:dart": "npm run fixtures:generate && dart format tests/generated/models.dart tests/generated/models_test.dart && dart analyze tests/generated/models.dart tests/generated/models_test.dart && dart run tests/generated/models_test.dart",
    "test:all": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "3.2.4",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.json2model.desktop",
    "productName": "JSON2Model",
    "copyright": "Copyright © 2026 JSON2Model contributors",
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist-static/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/*.map"
    ],
    "extraFiles": [
      {
        "from": "electron/README.txt",
        "to": "README.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "win": {
      "icon": "build-resources/icon.ico"
    }
  },
  "type": "module"
}
